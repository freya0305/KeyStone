# =============================================================================
# KeyStone Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ---- AI / LLM ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Stripe (Payment Processing) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Authentication (Clerk) ----
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- AWS (S3 for resume storage) ----
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=keystone-resumes

# ---- Internal API Key (for cron/admin endpoints) ----
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# ---- CORS ----
APP_CORS_ORIGINS=http://localhost:3000

# ---- App URL (for Stripe redirects, email links, etc.) ----
APP_URL=http://localhost:3000
