# ============================================================
# KeyStone Environment Configuration
# Copy to .env and fill in your API keys: cp .env.example .env
# ============================================================

# ── Application ─────────────────────────────────────────────
DEBUG=false

# ── Claude AI (REQUIRED) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (REQUIRED for payments) ──────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO=price_solo
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_TEAM=price_team

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters

# ── Clerk Authentication (REQUIRED) ─────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Application URLs ────────────────────────────────────────
APP_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# ── Internal Services ───────────────────────────────────────
INTERNAL_API_KEY=change-this-to-a-random-string

# ── AWS S3 ──────────────────────────────────────────────────
# For LOCAL DEVELOPMENT (with LocalStack):
#   docker compose up -d localstack  # Start LocalStack first
#   aws --endpoint-url=http://localhost:4566 s3 mb s3://keystone-resumes-dev
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=keystone-resumes-dev
AWS_REGION=ap-southeast-1

# For PRODUCTION (real AWS S3):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_ENDPOINT_URL=
# S3_BUCKET=keystone-resumes-prod
# AWS_REGION=ap-southeast-1

# ── Database ────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone

# ── Redis ───────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
